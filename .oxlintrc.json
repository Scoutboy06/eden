{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@octokit/**",
              "azure-devops-node-api",
              "azure-devops-node-api/**",
              "simple-git",
              "simple-git/**"
            ],
            "allowTypeImports": true,
            "message": "Vendor SDK runtime imports belong in src/external/. Import an Eden adapter instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/external/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
