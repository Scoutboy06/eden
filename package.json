{
  "name": "eden",
  "private": true,
  "bin": {
    "eden": "apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/web-ui"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun run apps/cli/src/main.ts",
    "test": "bun test",
    "test:fast": "bun run scripts/test.ts fast",
    "test:integration": "bun run scripts/test.ts integration",
    "test:full": "bun test",
    "test:profile": "bun run scripts/profile-tests.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "analyze": "fallow",
    "typecheck": "bun run typecheck:backend && bun run typecheck:web",
    "typecheck:backend": "tsc --project tsconfig.json",
    "typecheck:web": "tsc --project apps/web-ui/tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run analyze",
    "prepare": "husky",
    "web:dev": "bun run --cwd apps/web-ui dev",
    "web:build": "bun run --cwd apps/web-ui build"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "@octokit/rest": "^22.0.1",
    "azure-devops-node-api": "^17.0.1",
    "gunshi": "^0.37.3",
    "simple-git": "^4.0.2",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fallow": "^3.33.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
